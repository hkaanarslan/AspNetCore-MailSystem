@model Project2EmailNight.Entities.Message

@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="compose-page">
    <form asp-controller="Message"
          asp-action="CreateMessage"
          method="post"
          onsubmit="syncEditor()">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="compose-wrapper">

            <!-- HEADER -->
            <div class="compose-header">
                <div class="compose-title-pill">
                    <i class="bx bx-envelope"></i>
                    Yeni Mesaj
                </div>
                <a href="/Message/Inbox">Kapat</a>
            </div>

            <!-- BODY -->
            <div class="p-4 d-flex flex-column flex-grow-1">

                <!-- RECEIVER -->
                <div class="field-row">
                    <div class="field-label">Kime</div>
                    <input class="field-input"
                           asp-for="ReceiverEmail"
                           required />
                    <span class="text-danger" asp-validation-for="ReceiverEmail"></span>
                </div>

                <!-- SUBJECT -->
                <div class="field-row">
                    <div class="field-label">Konu</div>
                    <input class="field-input"
                           asp-for="Subject"
                           required />
                    <span class="text-danger" asp-validation-for="Subject"></span>
                </div>

                <!-- TOOLBAR -->
                <div class="editor-toolbar">
                    <button type="button" onclick="formatText('bold')"><b>B</b></button>
                    <button type="button" onclick="formatText('italic')"><i>I</i></button>
                    <button type="button" onclick="formatText('underline')"><u>U</u></button>
                </div>

                <!-- EDITOR -->
                <div id="editor"
                     class="editor"
                     contenteditable="true">
                    @Html.Raw(Model?.MessageDetail ?? "")
                </div>

                <input type="hidden"
                       asp-for="MessageDetail"
                       id="hiddenMessage" />

            </div>

            <!-- FOOTER -->
            <div class="compose-footer">

                <span class="compose-hint">
                    Ctrl + Enter ile gönder
                </span>

                <div class="d-flex gap-2">

                    <button type="submit"
                            name="submitType"
                            value="draft"
                            class="btn btn-outline-secondary">
                        Taslak Kaydet
                    </button>

                    <button type="submit"
                            name="submitType"
                            value="send"
                            class="btn-send">
                        Gönder
                    </button>

                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function formatText(command) {
            document.execCommand(command, false, null);
        }

        function syncEditor() {
            const editor = document.getElementById("editor");
            const hidden = document.getElementById("hiddenMessage");

            if (editor && hidden) {
                hidden.value = editor.innerHTML;
            }
        }

        document.addEventListener("keydown", function (e) {
            if (e.ctrlKey && e.key === "Enter") {
                e.preventDefault();
                syncEditor();
                document.querySelector("form").submit();
            }
        });

    </script>

}