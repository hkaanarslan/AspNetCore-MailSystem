@model Project2EmailNight.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hesap Bilgileri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mail-settings-wrapper">

    <div class="mail-header">
        <div class="mail-title-box">
            <i class="bx bx-user" style="font-size: 20px;"></i>
            <h2 class="mail-page-title">Hesap Bilgileri</h2>
        </div>
        <div class="header-actions">
            <a href="/Profile/Edit" class="btn-compose">
                <i class="bx bx-edit-alt"></i> Profili Düzenle
            </a>
        </div>
    </div>

    <div class="settings-layout-grid">

        <aside class="settings-sidebar">

            <div class="sidebar-card account-identity-card">
                <div class="avatar-wrapper">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-avatar.png" : Model.ImageUrl)" alt="Profil" />
                    <div class="online-indicator"></div>
                </div>
                <h3 class="user-fullname">@Model.Name @Model.Surname</h3>
                <span class="user-email-text">@Model.Email</span>
                <span class="badge-active"><i class="bx bx-check-circle"></i> Aktif Kullanıcı</span>
            </div>

            <div class="sidebar-card">
                <div class="card-title-small"><i class="bx bx-user-circle"></i> Kişisel Bilgiler</div>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div class="info-box">
                        <span class="info-label">Telefon Numarası</span>
                        <span class="info-value">@(Model.Phone ?? "-")</span>
                    </div>
                    <div class="info-box">
                        <span class="info-label">Doğum Tarihi</span>
                        <span class="info-value">@(Model.BirthDate?.ToString("dd MMM yyyy") ?? "-")</span>
                    </div>
                    <div class="info-box">
                        <span class="info-label">Şehir / Bölge</span>
                        <span class="info-value">@(Model.City ?? "-")</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-card" style="padding: 0; overflow: hidden;">
                <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); background: #fafaf9;">
                    <div class="card-title-small" style="margin: 0;"><i class="bx bx-map-pin"></i> Konum</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.City))
                {
                    <iframe width="100%" height="220"
                            style="border:0; display:block;"
                            src="https://maps.google.com/maps?q=@Model.City&t=&z=12&ie=UTF8&iwloc=&output=embed">
                    </iframe>
                }
                else
                {
                    <div class="empty-map-state" style="height: 220px;">
                        <i class="bx bx-map-alt"></i> Konum bilgisi eklenmemiş
                    </div>
                }
            </div>

        </aside>

        <main class="settings-main-content">

            <!-- 8 WIDGET GRID -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px;">

                <div class="dash-card" onclick="location.href='/Message/Inbox'">
                    <div class="dash-icon" style="background: #f3e8ff; color: #7c3aed;">
                        <i class="bx bx-envelope"></i>
                    </div>
                    <div>
                        <div class="dash-title">Gelen Kutusu</div>
                        <div class="dash-count">@Model.InboxCount</div>
                    </div>
                </div>

                <div class="dash-card" onclick="location.href='/Message/Sendbox'">
                    <div class="dash-icon" style="background: #ecfdf5; color: #10b981;">
                        <i class="bx bx-send"></i>
                    </div>
                    <div>
                        <div class="dash-title">Gönderilenler</div>
                        <div class="dash-count">@Model.SendCount</div>
                    </div>
                </div>

                <div class="dash-card" onclick="location.href='/Message/Starred'">
                    <div class="dash-icon" style="background: #fef3c7; color: #f59e0b;">
                        <i class="bx bx-star"></i>
                    </div>
                    <div>
                        <div class="dash-title">Yıldızlı</div>
                        <div class="dash-count">@Model.StarredCount</div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-icon" style="background: #fee2e2; color: #ef4444;">
                        <i class="bx bx-envelope-open"></i>
                    </div>
                    <div>
                        <div class="dash-title">Okunmamış</div>
                        <div class="dash-count">@Model.UnreadCount</div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-icon" style="background: #f3f4f6; color: #6b7280;">
                        <i class="bx bx-trash"></i>
                    </div>
                    <div>
                        <div class="dash-title">Silinenler</div>
                        <div class="dash-count">@Model.DeletedCount</div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-icon" style="background: #dbeafe; color: #2563eb;">
                        <i class="bx bx-time"></i>
                    </div>
                    <div>
                        <div class="dash-title">Son 7 Gün</div>
                        <div class="dash-count">@Model.Last7DaysCount</div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-icon" style="background: #fce7f3; color: #db2777;">
                        <i class="bx bx-edit"></i>
                    </div>
                    <div>
                        <div class="dash-title">Taslaklar</div>
                        <div class="dash-count">@Model.DraftCount</div>
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-icon" style="background: #dcfce7; color: #16a34a;">
                        <i class="bx bx-data"></i>
                    </div>
                    <div>
                        <div class="dash-title">Toplam Mesaj</div>
                        <div class="dash-count">@Model.TotalMessageCount</div>
                    </div>
                </div>

            </div>

            <section class="content-section">
                <div class="section-header">
                    <h4><i class="bx bx-info-circle"></i> Hakkında</h4>
                </div>
                <div class="section-body">
                    <p class="about-text" style="margin: 0; line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.About) ? "Henüz açıklama eklenmemiş." : Model.About)
                    </p>
                </div>
            </section>

            <section class="content-section">
                <div class="section-header">
                    <h4><i class="bx bx-bar-chart-alt-2"></i> Etiket İstatistikleri</h4>
                </div>
                <div class="section-body">
                    <div class="chart-wrapper">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </section>

        </main>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryLabels ?? new List<string>()));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryCounts ?? new List<int>()));

            if (labels.length === 0) return;

            new Chart(document.getElementById("categoryChart"), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: [
                            '#7c3aed',
                            '#10b981',
                            '#3b82f6',
                            '#f59e0b',
                            '#ef4444'
                        ],
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

        });
    </script>
}