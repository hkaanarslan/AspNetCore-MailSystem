@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mail@@ | Email Doğrulama</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #7c3aed;
            --secondary: #10b981;
            --text: #0f172a;
            --muted: #64748b;
        }

        * {
            font-family: 'Inter', sans-serif;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top, #ede9fe, #f6f7fb); /*  */
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            position: relative;
            overflow: hidden;
        }

            /* Arkaplana şıklık katan bulanık küre */
            body::before {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                background: rgba(124, 58, 237, 0.15);
                border-radius: 50%;
                filter: blur(80px);
                z-index: 0;
            }

        .confirm-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 28px;
            padding: 45px 40px;
            box-shadow: 0 40px 80px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.8);
            z-index: 1;
            text-align: center;
        }

        .icon-wrapper {
            width: 64px;
            height: 64px;
            background: rgba(124, 58, 237, 0.1);
            color: var(--primary);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

            .icon-wrapper svg {
                width: 32px;
                height: 32px;
            }

        h4 {
            font-weight: 800;
            color: var(--text);
            font-size: 24px;
            margin-bottom: 12px;
        }

        .email-text {
            font-size: 15px;
            color: var(--muted); /* [cite: 48] */
            line-height: 1.6;
            margin-bottom: 30px;
        }

            .email-text strong {
                color: var(--text);
                font-weight: 700;
            }

        /* Modern Onay Kodu Input Tasarımı */
        .code-input {
            text-align: center;
            font-size: 28px; /* [cite: 47] */
            letter-spacing: 12px;
            height: 65px;
            font-weight: 700;
            border-radius: 16px;
            border: 2px solid #e5e7eb;
            background: #f8fafc;
            color: var(--text);
            transition: all 0.25s ease;
            padding-left: 24px; /* Letter-spacing'i dengelemek için */
        }

            .code-input:focus {
                background: #ffffff;
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15);
                outline: none;
            }

            .code-input::placeholder {
                color: #cbd5e1;
            }

        .btn-confirm {
            width: 100%;
            border-radius: 16px;
            padding: 16px;
            font-weight: 700;
            font-size: 16px;
            background: var(--primary);
            border: none;
            color: white;
            transition: all .25s ease;
            margin-top: 10px;
        }

            .btn-confirm:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 30px rgba(124, 58, 237, 0.25);
                background: #6d28d9;
            }

        .text-danger {
            font-size: 13.5px;
            font-weight: 500;
            margin-top: 12px;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="confirm-card">

        <div class="icon-wrapper">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>

        <h4>Email Doğrulama</h4>

        <p class="email-text">
            <strong>@ViewBag.Email</strong> adresine gönderilen 6 haneli güvenlik kodunu giriniz.
        </p>

        <form method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="mb-3">
                <input type="text"
                       name="confirmCode"
                       maxlength="6"
                       pattern="[0-9]*"
                       class="form-control code-input"
                       placeholder="••••••"
                       autocomplete="off"
                       required />
            </div>

            <div class="text-danger" asp-validation-summary="ModelOnly"></div>

            <button class="btn-confirm" type="submit">Kodu Doğrula</button>
        </form>

    </div>

</body>
</html>